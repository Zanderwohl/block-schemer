#![enable(implicit_some)]
// Block Schemer's language: a small subset of R7RS. Opcodes are the Scheme
// names, so most blocks generate `(opcode arguments…)`; `codegen.rs` handles
// the rest. Categories, input names and faint words follow R7RS's own.
Language(
    name: "Block Schemer",
    file: (extension: "scmb", description: "Block Schemer program"),

    types: {
        // Any literal: a number, boolean, character, string in quotes, or
        // symbol. Checked by the `datum` validator and emitted as typed.
        "datum": (shape: Round, literal: Custom("datum")),
        // Escaped by the code generator, so any text goes.
        "string": (shape: Round, literal: Text),
        "symbol": (shape: Square, literal: Custom("symbol")),
        "binding": (shape: Square),
    },

    categories: [
        (name: "Program structure", color: (hue: 95.0)),
        (name: "Primitive expressions", color: (hue: 60.0)),
        (name: "Derived expressions", color: (hue: 25.0)),
        (name: "Control features", color: (hue: 260.0)),
        (name: "Numbers", color: (hue: 145.0)),
        (name: "Pairs and lists", color: (hue: 330.0)),
        (name: "Input and output", color: (hue: 190.0)),
    ],

    blocks: [
        // Program structure
        (
            id: "program",
            name: "Program",
            category: "Program structure",
            kind: HatCap,
            spec: "program {main:datum}",
            description: "Where your program begins.",
        ),
        (
            id: "define",
            name: "Define",
            category: "Program structure",
            kind: Reporter("datum"),
            spec: "define {variable:symbol} {expression:datum}",
            layout: Body(1),
        ),
        (
            id: "define_procedure",
            name: "Define procedure",
            category: "Program structure",
            kind: Reporter("datum"),
            spec: "define {variable:symbol} _taking_ {formals:symbol*} {body:datum+}",
            hints: {"formals": "variable", "body": "expression"},
            layout: Body(2),
        ),

        // Primitive expressions
        (id: "variable", name: "Variable", category: "Primitive expressions", kind: Reporter("datum"), spec: "{variable:symbol}"),
        (id: "quote", name: "Quote", category: "Primitive expressions", kind: Reporter("datum"), spec: "quote {datum:datum}"),
        (id: "string", name: "String", category: "Primitive expressions", kind: Reporter("datum"), spec: "\"{text:string}\""),
        (
            id: "call",
            name: "Call",
            category: "Primitive expressions",
            kind: Reporter("datum"),
            spec: "{operator:datum} {operands:datum*}",
            hints: {"operands": "operand"},
            description: "Calls any procedure, named or computed.",
        ),
        (
            id: "lambda",
            name: "Lambda",
            category: "Primitive expressions",
            kind: Reporter("datum"),
            spec: "lambda {formals:symbol*} {body:datum+}",
            hints: {"formals": "variable", "body": "expression"},
            layout: Body(1),
        ),
        (
            id: "if",
            name: "If",
            category: "Primitive expressions",
            kind: Reporter("datum"),
            spec: "if {test:datum} _then_ {consequent:datum} _else_ {alternate:datum}",
            layout: Body(1),
        ),

        // Derived expressions
        (
            id: "let",
            name: "Let",
            category: "Derived expressions",
            kind: Reporter("datum"),
            spec: "let {bindings:binding*} {body:datum+}",
            hints: {"bindings": "binding", "body": "expression"},
            layout: Body(1),
        ),
        (
            id: "binding",
            name: "Binding",
            category: "Derived expressions",
            kind: Reporter("binding"),
            spec: "{variable:symbol} _as_ {init:datum}",
        ),
        (
            id: "begin",
            name: "Begin",
            category: "Derived expressions",
            kind: Reporter("datum"),
            spec: "begin {expressions:datum+}",
            hints: {"expressions": "expression"},
            layout: Body(0),
        ),

        // Control features
        (
            id: "apply",
            name: "Apply",
            category: "Control features",
            kind: Reporter("datum"),
            spec: "apply {proc:datum} {args:datum+}",
            hints: {"args": "arg"},
            description: "Calls the procedure with the arguments, the last of which is a list spread out.",
        ),
        (
            id: "map",
            name: "Map",
            category: "Control features",
            kind: Reporter("datum"),
            spec: "map {proc:datum} {lists:datum+}",
            hints: {"lists": "list"},
        ),

        // Numbers
        (id: "+", name: "Add", category: "Numbers", kind: Reporter("datum"), spec: "+ {z:datum*}"),
        (id: "-", name: "Subtract", category: "Numbers", kind: Reporter("datum"), spec: "- {z:datum+}"),
        (id: "*", name: "Multiply", category: "Numbers", kind: Reporter("datum"), spec: "* {z:datum*}"),
        (id: "/", name: "Divide", category: "Numbers", kind: Reporter("datum"), spec: "/ {z:datum+}"),
        (id: "=", name: "Equal", category: "Numbers", kind: Reporter("datum"), spec: "= {z:datum+}"),
        (id: "<", name: "Less than", category: "Numbers", kind: Reporter("datum"), spec: "< {x:datum+}"),

        // Pairs and lists
        (id: "cons", name: "Cons", category: "Pairs and lists", kind: Reporter("datum"), spec: "cons {car:datum} {cdr:datum}"),
        (id: "car", name: "Car", category: "Pairs and lists", kind: Reporter("datum"), spec: "car {pair:datum}"),
        (id: "cdr", name: "Cdr", category: "Pairs and lists", kind: Reporter("datum"), spec: "cdr {pair:datum}"),
        (id: "list", name: "List", category: "Pairs and lists", kind: Reporter("datum"), spec: "list {obj:datum*}"),
        (
            id: "fold",
            name: "Fold",
            category: "Pairs and lists",
            kind: Reporter("datum"),
            spec: "fold {kons:datum} {knil:datum} {clist:datum}",
            description: "SRFI 1's fold over one list: calls kons with each element and the result so far, starting from knil.",
        ),

        // Input and output
        (id: "display", name: "Display", category: "Input and output", kind: Reporter("datum"), spec: "display {obj:datum}"),
    ],
)
