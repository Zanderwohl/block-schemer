#![enable(implicit_some)]
// Block Schemer's language: a small subset of R7RS. Opcodes are the Scheme
// names, so most blocks generate `(opcode arguments…)`; `codegen.rs` handles
// the rest. A user can run only the blocks offered here.
Language(
    name: "Block Schemer",
    file: (extension: "scmb", description: "Block Schemer program"),

    types: {
        // Any literal: a number, boolean, character, string in quotes, or
        // symbol. Checked by the `datum` validator and emitted as typed.
        "datum": (shape: Round, literal: Custom("datum")),
        // Escaped by the code generator, so any text goes.
        "string": (shape: Round, literal: Text),
        "symbol": (shape: Square, literal: Custom("symbol")),
        "binding": (shape: Square),
    },

    categories: [
        (name: "Program", color: (hue: 95.0)),
        (name: "Forms", color: (hue: 60.0)),
        (name: "Procedures", color: (hue: 260.0)),
        (name: "Arithmetic", color: (hue: 145.0)),
        (name: "Lists", color: (hue: 330.0)),
        (name: "Data", color: (hue: 190.0)),
    ],

    blocks: [
        // Program
        (
            id: "program",
            name: "Program",
            category: "Program",
            kind: Hat,
            spec: "program {main:datum}",
            description: "Where a program begins: evaluates its one expression.",
        ),

        // Forms
        (
            id: "define",
            name: "Define",
            category: "Forms",
            kind: Reporter("datum"),
            spec: "define {name:symbol} {value:datum}",
            layout: Body(1),
        ),
        (
            id: "define_procedure",
            name: "Define procedure",
            category: "Forms",
            kind: Reporter("datum"),
            spec: "define {name:symbol} taking {params:symbol*} {body:datum+}",
            hints: {"params": "param", "body": "expression"},
            layout: Body(2),
        ),
        (
            id: "if",
            name: "If",
            category: "Forms",
            kind: Reporter("datum"),
            spec: "if {test:datum} then {consequent:datum} else {alternate:datum}",
            hints: {"consequent": "if true", "alternate": "if false"},
            layout: Body(1),
        ),
        (
            id: "let",
            name: "Let",
            category: "Forms",
            kind: Reporter("datum"),
            spec: "let {bindings:binding*} {body:datum+}",
            hints: {"bindings": "binding", "body": "expression"},
            layout: Body(1),
        ),
        (
            id: "binding",
            name: "Binding",
            category: "Forms",
            kind: Reporter("binding"),
            spec: "{name:symbol} := {value:datum}",
        ),
        (
            id: "begin",
            name: "Begin",
            category: "Forms",
            kind: Reporter("datum"),
            spec: "begin {body:datum+}",
            hints: {"body": "expression"},
            layout: Body(0),
        ),

        // Procedures
        (
            id: "lambda",
            name: "Lambda",
            category: "Procedures",
            kind: Reporter("datum"),
            spec: "lambda {params:symbol*} {body:datum+}",
            hints: {"params": "param", "body": "expression"},
            layout: Body(1),
        ),
        (
            id: "call",
            name: "Call",
            category: "Procedures",
            kind: Reporter("datum"),
            spec: "{procedure:datum} {args:datum*}",
            hints: {"args": "argument"},
            description: "Calls any procedure, named or computed.",
        ),
        (
            id: "apply",
            name: "Apply",
            category: "Procedures",
            kind: Reporter("datum"),
            spec: "apply {procedure:datum} {args:datum+}",
            hints: {"args": "argument"},
            description: "Calls the procedure with the arguments, the last of which is a list spread out.",
        ),

        // Arithmetic
        (id: "+", name: "Add", category: "Arithmetic", kind: Reporter("datum"), spec: "+ {args:datum*}", hints: {"args": "operand"}),
        (id: "-", name: "Subtract", category: "Arithmetic", kind: Reporter("datum"), spec: "- {args:datum+}", hints: {"args": "operand"}),
        (id: "*", name: "Multiply", category: "Arithmetic", kind: Reporter("datum"), spec: "* {args:datum*}", hints: {"args": "operand"}),
        (id: "/", name: "Divide", category: "Arithmetic", kind: Reporter("datum"), spec: "/ {args:datum+}", hints: {"args": "operand"}),
        (id: "=", name: "Equal", category: "Arithmetic", kind: Reporter("datum"), spec: "= {args:datum+}", hints: {"args": "operand"}),
        (id: "<", name: "Less than", category: "Arithmetic", kind: Reporter("datum"), spec: "< {args:datum+}", hints: {"args": "operand"}),

        // Lists
        (id: "list", name: "List", category: "Lists", kind: Reporter("datum"), spec: "list {items:datum*}", hints: {"items": "item"}),
        (id: "cons", name: "Cons", category: "Lists", kind: Reporter("datum"), spec: "cons {car:datum} {cdr:datum}"),
        (id: "car", name: "Car", category: "Lists", kind: Reporter("datum"), spec: "car {pair:datum}"),
        (id: "cdr", name: "Cdr", category: "Lists", kind: Reporter("datum"), spec: "cdr {pair:datum}"),
        (
            id: "map",
            name: "Map",
            category: "Lists",
            kind: Reporter("datum"),
            spec: "map {procedure:datum} {lists:datum+}",
            hints: {"lists": "list"},
        ),
        (
            id: "reduce",
            name: "Reduce",
            category: "Lists",
            kind: Reporter("datum"),
            spec: "reduce {procedure:datum} {initial:datum} {list:datum}",
            description: "SRFI 1's reduce: folds the list with the procedure, or gives the initial value if it is empty.",
        ),

        // Data
        (id: "quote", name: "Quote", category: "Data", kind: Reporter("datum"), spec: "quote {datum:datum}"),
        (id: "string", name: "String", category: "Data", kind: Reporter("datum"), spec: "\"{text:string}\""),
        (id: "variable", name: "Variable", category: "Data", kind: Reporter("datum"), spec: "{name:symbol}"),
        (id: "display", name: "Display", category: "Data", kind: Reporter("datum"), spec: "display {value:datum}"),
    ],
)
