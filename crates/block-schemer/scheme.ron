#![enable(implicit_some)]
// Block Schemer's language: R7RS's standard procedures and a few of its
// forms. Opcodes are the Scheme names, so most blocks generate
// `(opcode arguments…)`; `codegen.rs` handles the rest. Categories, input
// names and faint words follow R7RS's own; optional arguments are a list
// after the required ones. Tags: `basics` for the most used, and the R7RS
// library a block comes from.
Language(
    name: "Block Schemer",
    file: (extension: "scmb", description: "Block Schemer program"),

    types: {
        // Any literal: a number, boolean, character, string in quotes, or
        // symbol. Checked by the `datum` validator and emitted as typed.
        "datum": (shape: Round, literal: Custom("datum")),
        // Escaped by the code generator, so any text goes.
        "string": (shape: Round, literal: Text),
        "symbol": (shape: Square, literal: Custom("symbol")),
        "binding": (shape: Square),
        // A procedure block dropped here with nothing filled in is its name:
        // `+`, not `(+)`. A round block here is called for the procedure.
        "procedure": (shape: Square, literal: Custom("symbol"), accepts: Types(["datum"]), by_name: true),
    },

    categories: [
        (name: "Program structure", color: (hue: 95.0)),
        (name: "Primitive expression types", color: (hue: 60.0)),
        (name: "Derived expression types", color: (hue: 25.0)),
        (name: "Equivalence predicates", color: (hue: 78.0)),
        (name: "Numbers", color: (hue: 145.0)),
        (name: "Booleans", color: (hue: 115.0)),
        (name: "Pairs and lists", color: (hue: 330.0)),
        (name: "CxR", color: (hue: 314.0)),
        (name: "Symbols", color: (hue: 244.0)),
        (name: "Characters", color: (hue: 210.0)),
        (name: "Strings", color: (hue: 228.0)),
        (name: "Vectors", color: (hue: 280.0)),
        (name: "Bytevectors", color: (hue: 298.0)),
        (name: "Control features", color: (hue: 260.0)),
        (name: "Exceptions", color: (hue: 5.0)),
        (name: "Delayed evaluation", color: (hue: 45.0)),
        (name: "Input and output", color: (hue: 190.0)),
        (name: "System interface", color: (hue: 165.0)),
    ],

    checked_tags: ["basics"],

    // Procedures can be named or called with fewer of their parameters,
    // which is an arity problem: Scheme does not curry. Syntax opts out.
    callable: true,

    blocks: [
        // Program structure
        (
            id: "program",
            name: "Program",
            category: "Program structure",
            kind: HatCap,
            spec: "program {main:datum}",
            description: "Where your program begins.",
            tags: ["basics"],
        ),
        (
            id: "define",
            callable: false,
            name: "Define",
            category: "Program structure",
            kind: Reporter("datum"),
            spec: "define {variable:symbol} {expression:datum}",
            layout: Body(1),
            // Over everything, as a top-level definition is.
            scope: (declares: ["variable"], global: ["variable"], reference: "variable"),
            tags: ["basics", "base"],
        ),
        (
            id: "define_procedure",
            callable: false,
            name: "Define procedure",
            category: "Program structure",
            kind: Reporter("datum"),
            spec: "define {variable:symbol} _taking_ {formals:symbol*} {body:datum+}",
            hints: {"formals": "parameter", "body": "expression"},
            layout: Body(2),
            // The name everywhere, as a top-level definition's; the formals in the body.
            scope: (
                declares: ["variable", "formals"], over: ["body"], global: ["variable"], reference: "variable",
                signature: (name: "variable", parameters: "formals", reference: "procedure_call"),
            ),
            tags: ["basics", "base"],
        ),

        // Primitive expression types
        (id: "variable", name: "Variable", category: "Primitive expression types", kind: Reporter("datum"), spec: "{variable:symbol}", tags: ["basics"]),
        (id: "quote", callable: false, name: "Quote", category: "Primitive expression types", kind: Reporter("datum"), spec: "quote {datum:datum}", tags: ["basics", "base"]),
        (id: "string", callable: false, name: "String", category: "Primitive expression types", kind: Reporter("datum"), spec: "\"{text:string}\"", tags: ["basics"]),
        (
            id: "procedure_call",
            name: "Procedure call",
            category: "Primitive expression types",
            kind: Reporter("datum"),
            spec: "{variable:symbol} {arguments:datum*}",
            hints: {"arguments": "argument"},
            description: "Calls a procedure by name. Dragged out of a definition's name, it has an argument per parameter.",
        ),
        (
            id: "call",
            name: "Call",
            category: "Primitive expression types",
            kind: Reporter("datum"),
            spec: "{operator:procedure} {operands:datum*}",
            hints: {"operands": "operand"},
            description: "Calls any procedure, named or computed.",
            tags: ["basics"],
        ),
        (
            id: "lambda",
            callable: false,
            name: "Lambda",
            category: "Primitive expression types",
            kind: Reporter("datum"),
            spec: "lambda {formals:symbol*} {body:datum+}",
            hints: {"formals": "parameter", "body": "expression"},
            layout: Body(1),
            scope: (declares: ["formals"], over: ["body"], reference: "variable"),
            tags: ["basics", "base"],
        ),
        (
            id: "if",
            callable: false,
            name: "If",
            category: "Primitive expression types",
            kind: Reporter("datum"),
            spec: "if {test:datum} _then_ {consequent:datum} _else_ {alternate:datum}",
            layout: Body(1),
            tags: ["basics", "base"],
        ),

        // Derived expression types
        (
            id: "let",
            callable: false,
            name: "Let",
            category: "Derived expression types",
            kind: Reporter("datum"),
            spec: "let {bindings:binding*} {body:datum+}",
            hints: {"bindings": "binding", "body": "expression"},
            layout: Body(1),
            // Not over the bindings' inits: as in Scheme, they see the outside.
            scope: (declares: ["bindings"], over: ["body"]),
            tags: ["basics", "base"],
        ),
        (
            id: "binding",
            name: "Binding",
            category: "Derived expression types",
            kind: Reporter("binding"),
            spec: "{variable:symbol} _be_ {init:datum}",
            // Into the body of the `let` holding it.
            scope: (declares: ["variable"], reference: "variable"),
            tags: ["basics"],
        ),
        (
            id: "begin",
            callable: false,
            name: "Begin",
            category: "Derived expression types",
            kind: Reporter("datum"),
            spec: "begin {expressions:datum+}",
            hints: {"expressions": "expression"},
            layout: Body(0),
            tags: ["basics", "base"],
        ),

        // Equivalence predicates
        (id: "eqv?", name: "Equivalent", category: "Equivalence predicates", kind: Reporter("datum"), spec: "eqv? {obj1:datum} {obj2:datum}", tags: ["basics", "base"]),
        (id: "eq?", name: "Identical", category: "Equivalence predicates", kind: Reporter("datum"), spec: "eq? {obj1:datum} {obj2:datum}", tags: ["basics", "base"]),
        (id: "equal?", name: "Equal structure", category: "Equivalence predicates", kind: Reporter("datum"), spec: "equal? {obj1:datum} {obj2:datum}", tags: ["basics", "base"], description: "Compares pairs, vectors, strings and bytevectors by their contents."),

        // Numbers
        (id: "number?", name: "Is number", category: "Numbers", kind: Reporter("datum"), spec: "number? {obj:datum}", tags: ["base"]),
        (id: "complex?", name: "Is complex", category: "Numbers", kind: Reporter("datum"), spec: "complex? {obj:datum}", tags: ["base"]),
        (id: "real?", name: "Is real", category: "Numbers", kind: Reporter("datum"), spec: "real? {obj:datum}", tags: ["base"]),
        (id: "rational?", name: "Is rational", category: "Numbers", kind: Reporter("datum"), spec: "rational? {obj:datum}", tags: ["base"]),
        (id: "integer?", name: "Is integer", category: "Numbers", kind: Reporter("datum"), spec: "integer? {obj:datum}", tags: ["base"]),
        (id: "exact?", name: "Is exact", category: "Numbers", kind: Reporter("datum"), spec: "exact? {z:datum}", tags: ["base"]),
        (id: "inexact?", name: "Is inexact", category: "Numbers", kind: Reporter("datum"), spec: "inexact? {z:datum}", tags: ["base"]),
        (id: "exact-integer?", name: "Is exact integer", category: "Numbers", kind: Reporter("datum"), spec: "exact-integer? {z:datum}", tags: ["base"]),
        (id: "finite?", name: "Is finite", category: "Numbers", kind: Reporter("datum"), spec: "finite? {z:datum}", tags: ["inexact"]),
        (id: "infinite?", name: "Is infinite", category: "Numbers", kind: Reporter("datum"), spec: "infinite? {z:datum}", tags: ["inexact"]),
        (id: "nan?", name: "Is NaN", category: "Numbers", kind: Reporter("datum"), spec: "nan? {z:datum}", tags: ["inexact"]),
        (id: "=", name: "Equal", category: "Numbers", kind: Reporter("datum"), spec: "= {z:datum+}", tags: ["basics", "base"]),
        (id: "<", name: "Less than", category: "Numbers", kind: Reporter("datum"), spec: "< {x:datum+}", tags: ["basics", "base"]),
        (id: ">", name: "Greater than", category: "Numbers", kind: Reporter("datum"), spec: "> {x:datum+}", tags: ["basics", "base"]),
        (id: "<=", name: "At most", category: "Numbers", kind: Reporter("datum"), spec: "<= {x:datum+}", tags: ["basics", "base"]),
        (id: ">=", name: "At least", category: "Numbers", kind: Reporter("datum"), spec: ">= {x:datum+}", tags: ["basics", "base"]),
        (id: "zero?", name: "Is zero", category: "Numbers", kind: Reporter("datum"), spec: "zero? {z:datum}", tags: ["basics", "base"]),
        (id: "positive?", name: "Is positive", category: "Numbers", kind: Reporter("datum"), spec: "positive? {x:datum}", tags: ["basics", "base"]),
        (id: "negative?", name: "Is negative", category: "Numbers", kind: Reporter("datum"), spec: "negative? {x:datum}", tags: ["basics", "base"]),
        (id: "odd?", name: "Is odd", category: "Numbers", kind: Reporter("datum"), spec: "odd? {n:datum}", tags: ["basics", "base"]),
        (id: "even?", name: "Is even", category: "Numbers", kind: Reporter("datum"), spec: "even? {n:datum}", tags: ["basics", "base"]),
        (id: "max", name: "Maximum", category: "Numbers", kind: Reporter("datum"), spec: "max {x:datum+}", tags: ["basics", "base"]),
        (id: "min", name: "Minimum", category: "Numbers", kind: Reporter("datum"), spec: "min {x:datum+}", tags: ["basics", "base"]),
        (id: "+", name: "Add", category: "Numbers", kind: Reporter("datum"), spec: "+ {z:datum*}", tags: ["basics", "base"]),
        (id: "*", name: "Multiply", category: "Numbers", kind: Reporter("datum"), spec: "* {z:datum*}", tags: ["basics", "base"]),
        (id: "-", name: "Subtract", category: "Numbers", kind: Reporter("datum"), spec: "- {z:datum+}", tags: ["basics", "base"]),
        (id: "/", name: "Divide", category: "Numbers", kind: Reporter("datum"), spec: "/ {z:datum+}", tags: ["basics", "base"]),
        (id: "abs", name: "Absolute value", category: "Numbers", kind: Reporter("datum"), spec: "abs {x:datum}", tags: ["basics", "base"]),
        (id: "floor/", name: "Floor divide", category: "Numbers", kind: Reporter("datum"), spec: "floor/ {n1:datum} {n2:datum}", tags: ["base"], description: "The quotient rounded down and its remainder, as two values."),
        (id: "floor-quotient", name: "Floor quotient", category: "Numbers", kind: Reporter("datum"), spec: "floor-quotient {n1:datum} {n2:datum}", tags: ["base"]),
        (id: "floor-remainder", name: "Floor remainder", category: "Numbers", kind: Reporter("datum"), spec: "floor-remainder {n1:datum} {n2:datum}", tags: ["base"]),
        (id: "truncate/", name: "Truncate divide", category: "Numbers", kind: Reporter("datum"), spec: "truncate/ {n1:datum} {n2:datum}", tags: ["base"], description: "The quotient rounded toward zero and its remainder, as two values."),
        (id: "truncate-quotient", name: "Truncate quotient", category: "Numbers", kind: Reporter("datum"), spec: "truncate-quotient {n1:datum} {n2:datum}", tags: ["base"]),
        (id: "truncate-remainder", name: "Truncate remainder", category: "Numbers", kind: Reporter("datum"), spec: "truncate-remainder {n1:datum} {n2:datum}", tags: ["base"]),
        (id: "quotient", name: "Quotient", category: "Numbers", kind: Reporter("datum"), spec: "quotient {n1:datum} {n2:datum}", tags: ["basics", "base"]),
        (id: "remainder", name: "Remainder", category: "Numbers", kind: Reporter("datum"), spec: "remainder {n1:datum} {n2:datum}", tags: ["basics", "base"]),
        (id: "modulo", name: "Modulo", category: "Numbers", kind: Reporter("datum"), spec: "modulo {n1:datum} {n2:datum}", tags: ["basics", "base"]),
        (id: "gcd", name: "Greatest common divisor", category: "Numbers", kind: Reporter("datum"), spec: "gcd {n:datum*}", tags: ["base"]),
        (id: "lcm", name: "Least common multiple", category: "Numbers", kind: Reporter("datum"), spec: "lcm {n:datum*}", tags: ["base"]),
        (id: "numerator", name: "Numerator", category: "Numbers", kind: Reporter("datum"), spec: "numerator {q:datum}", tags: ["base"]),
        (id: "denominator", name: "Denominator", category: "Numbers", kind: Reporter("datum"), spec: "denominator {q:datum}", tags: ["base"]),
        (id: "floor", name: "Floor", category: "Numbers", kind: Reporter("datum"), spec: "floor {x:datum}", tags: ["basics", "base"]),
        (id: "ceiling", name: "Ceiling", category: "Numbers", kind: Reporter("datum"), spec: "ceiling {x:datum}", tags: ["basics", "base"]),
        (id: "truncate", name: "Truncate", category: "Numbers", kind: Reporter("datum"), spec: "truncate {x:datum}", tags: ["basics", "base"]),
        (id: "round", name: "Round", category: "Numbers", kind: Reporter("datum"), spec: "round {x:datum}", tags: ["basics", "base"], description: "Rounds to the nearest integer, to even at a half."),
        (id: "rationalize", name: "Rationalize", category: "Numbers", kind: Reporter("datum"), spec: "rationalize {x:datum} {y:datum}", tags: ["base"], description: "The simplest rational number differing from x by no more than y."),
        (id: "exp", name: "Exponential", category: "Numbers", kind: Reporter("datum"), spec: "exp {z:datum}", tags: ["inexact"]),
        (id: "log", name: "Logarithm", category: "Numbers", kind: Reporter("datum"), spec: "log {z:datum} {base:datum*}", hints: {"base": "base"}, tags: ["inexact"], description: "The natural logarithm, or in the base given."),
        (id: "sin", name: "Sine", category: "Numbers", kind: Reporter("datum"), spec: "sin {z:datum}", tags: ["basics", "inexact"]),
        (id: "cos", name: "Cosine", category: "Numbers", kind: Reporter("datum"), spec: "cos {z:datum}", tags: ["basics", "inexact"]),
        (id: "tan", name: "Tangent", category: "Numbers", kind: Reporter("datum"), spec: "tan {z:datum}", tags: ["basics", "inexact"]),
        (id: "asin", name: "Arcsine", category: "Numbers", kind: Reporter("datum"), spec: "asin {z:datum}", tags: ["basics", "inexact"]),
        (id: "acos", name: "Arccosine", category: "Numbers", kind: Reporter("datum"), spec: "acos {z:datum}", tags: ["basics", "inexact"]),
        (id: "atan", name: "Arctangent", category: "Numbers", kind: Reporter("datum"), spec: "atan {y:datum} {x:datum*}", hints: {"x": "x"}, tags: ["basics", "inexact"], description: "The arctangent of y, or of y/x in the quadrant of the point (x, y)."),
        (id: "square", name: "Square", category: "Numbers", kind: Reporter("datum"), spec: "square {z:datum}", tags: ["basics", "base"]),
        (id: "sqrt", name: "Square root", category: "Numbers", kind: Reporter("datum"), spec: "sqrt {z:datum}", tags: ["basics", "inexact"]),
        (id: "exact-integer-sqrt", name: "Exact integer square root", category: "Numbers", kind: Reporter("datum"), spec: "exact-integer-sqrt {k:datum}", tags: ["base"], description: "The largest s with s² ≤ k, and k - s², as two values."),
        (id: "expt", name: "Power", category: "Numbers", kind: Reporter("datum"), spec: "expt {z1:datum} {z2:datum}", tags: ["basics", "base"]),
        (id: "make-rectangular", name: "Make rectangular", category: "Numbers", kind: Reporter("datum"), spec: "make-rectangular {x1:datum} {x2:datum}", tags: ["complex"]),
        (id: "make-polar", name: "Make polar", category: "Numbers", kind: Reporter("datum"), spec: "make-polar {x3:datum} {x4:datum}", tags: ["complex"]),
        (id: "real-part", name: "Real part", category: "Numbers", kind: Reporter("datum"), spec: "real-part {z:datum}", tags: ["complex"]),
        (id: "imag-part", name: "Imaginary part", category: "Numbers", kind: Reporter("datum"), spec: "imag-part {z:datum}", tags: ["complex"]),
        (id: "magnitude", name: "Magnitude", category: "Numbers", kind: Reporter("datum"), spec: "magnitude {z:datum}", tags: ["complex"]),
        (id: "angle", name: "Angle", category: "Numbers", kind: Reporter("datum"), spec: "angle {z:datum}", tags: ["complex"]),
        (id: "inexact", name: "Inexact", category: "Numbers", kind: Reporter("datum"), spec: "inexact {z:datum}", tags: ["base"]),
        (id: "exact", name: "Exact", category: "Numbers", kind: Reporter("datum"), spec: "exact {z:datum}", tags: ["base"]),
        (id: "number->string", name: "Number to string", category: "Numbers", kind: Reporter("datum"), spec: "number->string {z:datum} {radix:datum*}", hints: {"radix": "radix"}, tags: ["basics", "base"]),
        (id: "string->number", name: "String to number", category: "Numbers", kind: Reporter("datum"), spec: "string->number {string:datum} {radix:datum*}", hints: {"radix": "radix"}, tags: ["basics", "base"]),

        // Booleans
        (id: "not", name: "Not", category: "Booleans", kind: Reporter("datum"), spec: "not {obj:datum}", tags: ["basics", "base"]),
        (id: "boolean?", name: "Is boolean", category: "Booleans", kind: Reporter("datum"), spec: "boolean? {obj:datum}", tags: ["base"]),
        (id: "boolean=?", name: "Booleans equal", category: "Booleans", kind: Reporter("datum"), spec: "boolean=? {boolean1:datum} {boolean2:datum} {more:datum*}", hints: {"more": "boolean"}, tags: ["base"]),

        // Pairs and lists
        (id: "pair?", name: "Is pair", category: "Pairs and lists", kind: Reporter("datum"), spec: "pair? {obj:datum}", tags: ["basics", "base"]),
        (id: "cons", name: "Cons", category: "Pairs and lists", kind: Reporter("datum"), spec: "cons {car:datum} {cdr:datum}", tags: ["basics", "base"]),
        (id: "car", name: "Car", category: "Pairs and lists", kind: Reporter("datum"), spec: "car {pair:datum}", tags: ["basics", "base"]),
        (id: "cdr", name: "Cdr", category: "Pairs and lists", kind: Reporter("datum"), spec: "cdr {pair:datum}", tags: ["basics", "base"]),
        (id: "caar", name: "Caar", category: "Pairs and lists", kind: Reporter("datum"), spec: "caar {pair:datum}", tags: ["base"]),
        (id: "cadr", name: "Cadr", category: "Pairs and lists", kind: Reporter("datum"), spec: "cadr {pair:datum}", tags: ["base"]),
        (id: "cdar", name: "Cdar", category: "Pairs and lists", kind: Reporter("datum"), spec: "cdar {pair:datum}", tags: ["base"]),
        (id: "cddr", name: "Cddr", category: "Pairs and lists", kind: Reporter("datum"), spec: "cddr {pair:datum}", tags: ["base"]),
        (id: "null?", name: "Is empty list", category: "Pairs and lists", kind: Reporter("datum"), spec: "null? {obj:datum}", tags: ["basics", "base"]),
        (id: "list?", name: "Is list", category: "Pairs and lists", kind: Reporter("datum"), spec: "list? {obj:datum}", tags: ["basics", "base"]),
        (id: "make-list", name: "Make list", category: "Pairs and lists", kind: Reporter("datum"), spec: "make-list {k:datum} {fill:datum*}", hints: {"fill": "fill"}, tags: ["basics", "base"]),
        (id: "list", name: "List", category: "Pairs and lists", kind: Reporter("datum"), spec: "list {obj:datum*}", tags: ["basics", "base"]),
        (id: "length", name: "Length", category: "Pairs and lists", kind: Reporter("datum"), spec: "length {list:datum}", tags: ["basics", "base"]),
        (id: "append", name: "Append", category: "Pairs and lists", kind: Reporter("datum"), spec: "append {list:datum*}", tags: ["basics", "base"]),
        (id: "reverse", name: "Reverse", category: "Pairs and lists", kind: Reporter("datum"), spec: "reverse {list:datum}", tags: ["basics", "base"]),
        (id: "list-tail", name: "List tail", category: "Pairs and lists", kind: Reporter("datum"), spec: "list-tail {list:datum} {k:datum}", tags: ["base"]),
        (id: "list-ref", name: "List reference", category: "Pairs and lists", kind: Reporter("datum"), spec: "list-ref {list:datum} {k:datum}", tags: ["basics", "base"]),
        (id: "memq", name: "Member by eq?", category: "Pairs and lists", kind: Reporter("datum"), spec: "memq {obj:datum} {list:datum}", tags: ["base"]),
        (id: "memv", name: "Member by eqv?", category: "Pairs and lists", kind: Reporter("datum"), spec: "memv {obj:datum} {list:datum}", tags: ["base"]),
        (id: "member", name: "Member", category: "Pairs and lists", kind: Reporter("datum"), spec: "member {obj:datum} {list:datum} {compare:procedure*}", hints: {"compare": "compare"}, tags: ["base"], description: "The first tail of list whose car is equal? to obj, or compares with the procedure given."),
        (id: "assq", name: "Association by eq?", category: "Pairs and lists", kind: Reporter("datum"), spec: "assq {obj:datum} {alist:datum}", tags: ["base"]),
        (id: "assv", name: "Association by eqv?", category: "Pairs and lists", kind: Reporter("datum"), spec: "assv {obj:datum} {alist:datum}", tags: ["base"]),
        (id: "assoc", name: "Association", category: "Pairs and lists", kind: Reporter("datum"), spec: "assoc {obj:datum} {alist:datum} {compare:procedure*}", hints: {"compare": "compare"}, tags: ["base"], description: "The first pair in alist whose car is equal? to obj, or compares with the procedure given."),
        (id: "list-copy", name: "List copy", category: "Pairs and lists", kind: Reporter("datum"), spec: "list-copy {obj:datum}", tags: ["base"]),
        (
            id: "fold",
            name: "Fold",
            category: "Pairs and lists",
            kind: Reporter("datum"),
            spec: "fold {kons:procedure} {knil:datum} {clist:datum}",
            tags: ["basics", "(srfi 1)"],
            description: "SRFI 1's fold over one list: calls kons with each element and the result so far, starting from knil.",
        ),

        // CxR
        (id: "caaar", name: "Caaar", category: "CxR", kind: Reporter("datum"), spec: "caaar {pair:datum}", tags: ["cxr"]),
        (id: "caadr", name: "Caadr", category: "CxR", kind: Reporter("datum"), spec: "caadr {pair:datum}", tags: ["cxr"]),
        (id: "cadar", name: "Cadar", category: "CxR", kind: Reporter("datum"), spec: "cadar {pair:datum}", tags: ["cxr"]),
        (id: "caddr", name: "Caddr", category: "CxR", kind: Reporter("datum"), spec: "caddr {pair:datum}", tags: ["cxr"]),
        (id: "cdaar", name: "Cdaar", category: "CxR", kind: Reporter("datum"), spec: "cdaar {pair:datum}", tags: ["cxr"]),
        (id: "cdadr", name: "Cdadr", category: "CxR", kind: Reporter("datum"), spec: "cdadr {pair:datum}", tags: ["cxr"]),
        (id: "cddar", name: "Cddar", category: "CxR", kind: Reporter("datum"), spec: "cddar {pair:datum}", tags: ["cxr"]),
        (id: "cdddr", name: "Cdddr", category: "CxR", kind: Reporter("datum"), spec: "cdddr {pair:datum}", tags: ["cxr"]),
        (id: "caaaar", name: "Caaaar", category: "CxR", kind: Reporter("datum"), spec: "caaaar {pair:datum}", tags: ["cxr"]),
        (id: "caaadr", name: "Caaadr", category: "CxR", kind: Reporter("datum"), spec: "caaadr {pair:datum}", tags: ["cxr"]),
        (id: "caadar", name: "Caadar", category: "CxR", kind: Reporter("datum"), spec: "caadar {pair:datum}", tags: ["cxr"]),
        (id: "caaddr", name: "Caaddr", category: "CxR", kind: Reporter("datum"), spec: "caaddr {pair:datum}", tags: ["cxr"]),
