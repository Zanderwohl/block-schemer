        (id: "for-each", name: "For each", category: "Control features", kind: Reporter("datum"), spec: "for-each {proc:procedure} {lists:datum+}", hints: {"lists": "list"}, tags: ["basics", "base"], description: "Calls the procedure on each element in turn, for its effects."),
