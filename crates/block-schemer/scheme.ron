        (id: "read-bytevector!", name: "Read into bytevector", category: "Input and output", kind: Reporter("datum"), spec: "read-bytevector! {bytevector:datum} {port_range:datum*}", hints: {"port_range": "port, start, end"}, tags: ["base"]),
        (id: "write", name: "Write", category: "Input and output", kind: Reporter("datum"), spec: "write {obj:datum} {port:datum*}", shows: 1, hints: {"port": "port"}, tags: ["write"], description: "Writes obj as Scheme would read it back: strings in quotes, characters as #\\x."),
        (id: "write-shared", name: "Write shared", category: "Input and output", kind: Reporter("datum"), spec: "write-shared {obj:datum} {port:datum*}", shows: 1, hints: {"port": "port"}, tags: ["write"]),
        (id: "write-simple", name: "Write simple", category: "Input and output", kind: Reporter("datum"), spec: "write-simple {obj:datum} {port:datum*}", shows: 1, hints: {"port": "port"}, tags: ["write"]),
