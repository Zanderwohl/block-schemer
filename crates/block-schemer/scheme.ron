        // Control features
        (id: "procedure?", name: "Is procedure", category: "Control features", kind: Reporter("datum"), spec: "procedure? {obj:datum}", tags: ["basics", "base"]),
        (
            id: "apply",
            name: "Apply",
            category: "Control features",
            kind: Reporter("datum"),
            spec: "apply {proc:procedure} {args:datum+}",
            hints: {"args": "arg"},
            tags: ["basics", "base"],
            description: "Calls the procedure with the arguments, the last of which is a list spread out.",
        ),
        (
            id: "map",
            name: "Map",
            category: "Control features",
            kind: Reporter("datum"),
            spec: "map {proc:procedure} {lists:datum+}",
            hints: {"lists": "list"},
            tags: ["basics", "base"],
